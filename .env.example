# Example .env file for local development
# Copy this file to .env and fill in the values

# === Required ===

# Telegram Bot Token (get from @BotFather)
# Use a separate dev/beta bot, never the production one: two instances polling
# the same token get "409 Conflict" from Telegram and steal each other's updates
TELEGRAM_TOKEN=your_dev_telegram_bot_token_here

# Home Assistant API URL
# For local development use external address of your HA
HA_API_URL=http://192.168.1.100:8123/api

# Home Assistant Long-Lived Access Token
# Create in HA user profile: Profile -> Long-Lived Access Tokens
HA_TOKEN=your_home_assistant_token_here

# === Bot Commands (Optional) ===

# Chats allowed to use bot commands (comma-separated); empty disables commands
# Get your Chat ID from @userinfobot
ALLOWED_CHAT_IDS=123456789,987654321

# === Power Monitoring (Optional) ===

# Chat IDs for power notifications (can be different from ALLOWED_CHAT_IDS)
# Use channel ID for Telegram channels (starts with -100); use a dev/beta channel here
NOTIFICATION_CHAT_IDS=-1001234567890

# Entity ID of the power sensor to watch
WATCHED_ENTITY_ID=binary_sensor.power_status

# Entity ID of sensor with next power on time
NEXT_ON_SENSOR_ID=sensor.next_power_on

# Entity ID of sensor with next power off time
NEXT_OFF_SENSOR_ID=sensor.next_power_off

# Entity ID of input_boolean to pause notifications
PAUSE_ENTITY_ID=input_boolean.pause_power_notifications

# Timezone for time formatting
TIMEZONE=Europe/Kyiv

# === General Settings ===

# Log level: debug, info, warn, error
LOG_LEVEL=debug

# === Statistics (Optional) ===

# Path to statistics database
# For local development: ./power_stats.db
# For production (in HA add-on): /data/power_stats.db
STATS_DB_PATH=./power_stats.db

# === Yasno Schedule (Optional) ===

# Yasno Outages integration entities (check exact IDs in HA: Settings -> Entities)
YASNO_TODAY_SENSOR_ID=sensor.yasno_kiiv_2_1_status_today
YASNO_TOMORROW_SENSOR_ID=sensor.yasno_kiiv_2_1_status_tomorrow
YASNO_CALENDAR_ID=calendar.yasno_kiiv_2_1_planned_outages
